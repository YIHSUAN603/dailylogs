{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "日報告 DailyLogs",
  "version": "2.8.0",
  "identifier": "com.arieschao.dailylogs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "日報告 DailyLogs",
        "width": 1100,
        "height": 760,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMDQyREE5QjgzN0Y2ODMKUldTRDlqZTRxUzBFV3hhRXNOVmppK1hzc2l4WGx5UVZxNVlmTm0vNVV4eUFDWHNUTm5EODU4akcK",
      "endpoints": [
        "https://github.com/YIHSUAN603/dailylogs/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
